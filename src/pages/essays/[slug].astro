---
import Base from "../../layouts/Base.astro";
import { CATEGORIES, essaysIn } from "../../data/categories";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { title: c.title, essays: essaysIn(c.slug) },
  }));
}

const { title, essays } = Astro.props;
---

<Base
  pageTitle={title}
  description={`Essays on ${title} submitted to Overdue Progress's first essay competition.`}
  subtitle="The Essays"
  subtitleHref="/essays"
>
  <main class="sheet marked">
    <div class="sheet-head">
      <h1>{title}</h1>
      <div class="sheet-count" aria-label={`${essays.length} essays`}>
        {essays.length}
      </div>
    </div>

    <ul class="rows">
      {essays.map((essay) => (
        <li>
          <a class="row" href={essay.link} target="_blank" rel="noopener">
            <span>
              <span class="row-title">{essay.title}</span>
              <span class="row-meta">by {essay.author}</span>
            </span>
            <span class="row-aside">
              <span class="row-go" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 14 14 6M7.5 6H14v6.5" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
