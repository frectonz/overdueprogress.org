---
import Base from "../../layouts/Base.astro";
import { CATEGORIES, essays, essaysIn } from "../../data/categories";

const total = essays.length;
const categories = CATEGORIES.map((c) => ({
  ...c,
  count: essaysIn(c.slug).length,
}));
---

<Base
  pageTitle="The Essays"
  description={`All ${total} essays submitted to Overdue Progress's first essay competition, grouped by theme.`}
  subtitle="The Essays"
>
  <main class="sheet marked">
    <div class="sheet-head">
      <h1>The Essays</h1>
      <div class="sheet-count" aria-label={`${total} essays`}>
        {total}
      </div>
    </div>

    <div class="sheet-brief prose">
      <h2>Brief</h2>
      <p>
        Every essay submitted to the first
        <a href="/competition">Overdue Progress essay competition</a>, grouped
        by theme. Each one opens in the author's own document. The three winners
        and the fifteen finalists are on the
        <a href="/winners">winners page</a>.
      </p>
    </div>

    <ul class="rows">
      {categories.map((cat) => (
        <li>
          <a class="row" href={`/essays/${cat.slug}`}>
            <span class="row-title">{cat.title}</span>
            <span class="row-aside">
              <span>
                {cat.count} {cat.count === 1 ? "essay" : "essays"}
              </span>
              <span class="row-go" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
